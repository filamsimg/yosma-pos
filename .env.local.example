# Neon PostgreSQL Database Configuration
# Dapatkan string koneksi ini dari Dashboard Neon > Project > Connect (pilih Pooled Connection)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication Secret (Gunakan string acak minimal 32 karakter)
JWT_SECRET=rahasia_kunci_jwt_super_aman_yosma_pos_2026_minimal_32_karakter

# Registration Access Codes
ADMIN_INVITE_CODE=ISI_KODE_RAHASIA_DI_SINI
SALES_INVITE_CODE=ISI_KODE_RAHASIA_DI_SINI
DEFAULT_RESET_PASSWORD=isi_default_password


